						$action = '<a href="' . url('admin/purchase_order/project/progress/' . $val->id) . '" class="btn bg-success btn-sm" data-popup="tooltip" title="Detail"><i class="icon-search4"></i></a>';
					}elseif($uri[2] == 'delivery_order'){
