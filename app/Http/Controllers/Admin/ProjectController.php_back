		if(count($data->projectSale) > 0){
			foreach($data->projectSale as $pp) {
				$balance = floatval(str_replace(',','.',str_replace('.','',$pp->getTotal()))) - floatval(str_replace(',','.',str_replace('.','',$pp->getPaid())));
				
				$string .= '
					<tr>
