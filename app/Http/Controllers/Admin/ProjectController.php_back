			'code'        		=> strtoupper(Str::random(15)),
			'date'        		=> $request->date,
			'type'        		=> $type,
			'description' 		=> $description
		]);
		
		if($cb){
			
			CashBankDetail::create([
				'cash_bank_id' 	=> $cb->id,
				'coa_id'       	=> $debet1,
				'branch'		=> $purchasedelivery->projectSale->sales->branch,
				'type'       	=> '1',
