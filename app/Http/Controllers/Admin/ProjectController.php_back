				'branch'		   => $purchasedelivery->projectSale->sales->branch,
				'type'	           => '2',
				'nominal'          => round($kreditnominal1,0),
				'created_at'       => date('Y-m-d', strtotime($cb->date)) . ' ' . date('H:i:s'),
